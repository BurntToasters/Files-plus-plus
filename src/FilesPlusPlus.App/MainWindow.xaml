<Window
    x:Class="FilesPlusPlus.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FilesPlusPlus.App.Controls"
    xmlns:models="using:FilesPlusPlus.App.Models"
    xmlns:vm="using:FilesPlusPlus.App.ViewModels">

    
    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- Why: Root surface stays transparent so the native backdrop provides the window material. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        
        <!-- Section: Continuous top chrome atmosphere -->
        <Rectangle Grid.Row="0" Fill="{ThemeResource ShellBackdropOrbBrush}" IsHitTestVisible="False" />
        <Rectangle Grid.Row="0" Fill="{ThemeResource ShellBackdropTopGlowBrush}" IsHitTestVisible="False" />
        <Rectangle Grid.Row="0" Fill="{ThemeResource ShellTopChromeScrimBrush}" IsHitTestVisible="False" />

        
        <!-- Section: Full-bleed custom title chrome (flows under system caption buttons) -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource ShellTitleBarBorderBrush}" Background="{ThemeResource ShellTitleBarBackgroundBrush}">
            <Grid>
                <Border VerticalAlignment="Top" Height="10" Background="{ThemeResource ShellPanelTopSheenBrush}" IsHitTestVisible="False" />
                <Border VerticalAlignment="Top" Height="1" Margin="0,1,0,0" Background="{ThemeResource ShellChromeHighlightStripBrush}" Opacity="0.45" IsHitTestVisible="False" />

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="TitleBarRowDefinition" Height="32" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    
                    <!-- Section: Custom title bar (brand + tabs + drag + caption inset) -->
                    <Grid x:Name="TitleBarHost" Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="48" />
                            <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="138" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="12,0,8,0">
                            <FontIcon Glyph="&#xE8B7;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12" Foreground="{ThemeResource ShellTitleBarForegroundBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Files++" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ShellTitleBarForegroundBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Stretch" Margin="0,4,0,0" MaxWidth="720">
                            <ItemsControl ItemsSource="{Binding Tabs}" VerticalAlignment="Bottom">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            MinWidth="88"
                                            MaxWidth="170"
                                            Height="24"
                                            Padding="0"
                                            Margin="0,0,2,0"
                                            CornerRadius="4,4,0,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            UseSystemFocusVisuals="True"
                                            Click="TabButton_Click"
                                            AutomationProperties.Name="{Binding Header}"
                                            Tag="{Binding}">
                                            <Grid>
                                                <Border CornerRadius="4,4,0,0" Background="{ThemeResource ShellTabBackgroundBrush}" BorderBrush="{ThemeResource ShellTabBorderBrush}" BorderThickness="1,1,1,0" />
                                                <Border
                                                    CornerRadius="4,4,0,0"
                                                    Background="{ThemeResource ShellTabSelectedBackgroundBrush}"
                                                    BorderBrush="{ThemeResource ShellTabSelectedBorderBrush}"
                                                    BorderThickness="1,1,1,0"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <Border
                                                    VerticalAlignment="Top"
                                                    Height="8"
                                                    Margin="1,1,1,0"
                                                    CornerRadius="3,3,0,0"
                                                    Background="{ThemeResource ShellPanelTopSheenBrush}"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    IsHitTestVisible="False" />
                                                <Rectangle
                                                    VerticalAlignment="Bottom"
                                                    Height="2"
                                                    Margin="6,0,6,0"
                                                    Fill="{ThemeResource ShellTabIndicatorBrush}"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    IsHitTestVisible="False" />
                                                <Grid Padding="9,1" ColumnSpacing="3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Header}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{ThemeResource ShellTabForegroundBrush}" VerticalAlignment="Center" />
                                                    <Button
                                                        Grid.Column="1"
                                                        Width="14"
                                                        Height="14"
                                                        Padding="0"
                                                        Click="CloseTab_Click"
                                                        Tag="{Binding}"
                                                        UseSystemFocusVisuals="True"
                                                        AutomationProperties.Name="Close tab"
                                                        FontSize="9"
                                                        Foreground="{ThemeResource ShellTabCloseForegroundBrush}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Content="&#xE711;"
                                                        FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                                </Grid>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button
                            Grid.Column="3"
                            Style="{StaticResource ShellGlassButtonStyle}"
                            Width="22"
                            Height="22"
                            Padding="0"
                            Margin="2,0,4,1"
                            CornerRadius="3"
                            VerticalAlignment="Bottom"
                            Click="AddTab_Click"
                            AutomationProperties.Name="Add new tab"
                            ToolTipService.ToolTip="New tab">
                            <FontIcon Glyph="&#xE710;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="10" Foreground="{ThemeResource ShellIconForegroundBrush}" />
                        </Button>

                        <!-- Why: Drag region fills space before system caption buttons; right inset keeps content clear of min/max/close. -->
                        <Border x:Name="TitleBarDragRegion" Grid.Column="4" Background="Transparent" />
                        <Border Grid.Column="5" Background="Transparent" IsHitTestVisible="False" />
                    </Grid>

                    <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{ThemeResource ShellGlassEdgeSeparatorBrush}" Opacity="0.35" IsHitTestVisible="False" />

                    
                    <!-- Section: Unified toolbar -->
                    <Grid Grid.Row="1" Padding="8,4,8,6" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Padding="2" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource ShellSubtleBorderBrush}" Background="{ThemeResource ShellCommandStripBackgroundBrush}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="1">
                                <Button x:Name="BackButton" Style="{StaticResource ShellGlassButtonStyle}" Width="28" Height="26" Padding="0" CornerRadius="3" Click="Back_Click" ToolTipService.ToolTip="Back" AutomationProperties.Name="Back" IsEnabled="{Binding SelectedTab.CanGoBack}">
                                    <FontIcon Glyph="&#xE72B;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="13" Foreground="{ThemeResource ShellIconForegroundBrush}" />
                                </Button>
                                <Button x:Name="ForwardButton" Style="{StaticResource ShellGlassButtonStyle}" Width="28" Height="26" Padding="0" CornerRadius="3" Click="Forward_Click" ToolTipService.ToolTip="Forward" AutomationProperties.Name="Forward" IsEnabled="{Binding SelectedTab.CanGoForward}">
                                    <FontIcon Glyph="&#xE72A;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="13" Foreground="{ThemeResource ShellIconForegroundBrush}" />
                                </Button>
                                <Button Style="{StaticResource ShellGlassButtonStyle}" Width="28" Height="26" Padding="0" CornerRadius="3" Click="Up_Click" ToolTipService.ToolTip="Up" AutomationProperties.Name="Up">
                                    <FontIcon Glyph="&#xE74A;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="13" Foreground="{ThemeResource ShellIconForegroundBrush}" />
                                </Button>
                                <Button Style="{StaticResource ShellGlassButtonStyle}" Width="28" Height="26" Padding="0" CornerRadius="3" Click="Refresh_Click" ToolTipService.ToolTip="Refresh" AutomationProperties.Name="Refresh">
                                    <FontIcon Glyph="&#xE72C;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="13" Foreground="{ThemeResource ShellIconForegroundBrush}" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Padding="8,2" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource ShellInputBorderBrush}" Background="{ThemeResource ShellInputBackgroundBrush}" VerticalAlignment="Center" MinHeight="28">
                            <BreadcrumbBar x:Name="PathBreadcrumb" ItemsSource="{Binding SelectedTab.Breadcrumbs}" ItemClicked="Breadcrumb_ItemClicked" Background="Transparent" AutomationProperties.Name="Current path">
                                <BreadcrumbBar.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{ThemeResource ShellButtonForegroundBrush}" />
                                    </DataTemplate>
                                </BreadcrumbBar.ItemTemplate>
                            </BreadcrumbBar>
                        </Border>

                        <Border Grid.Column="2" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource ShellInputBorderBrush}" Background="{ThemeResource ShellInputBackgroundBrush}" VerticalAlignment="Center" MinHeight="28">
                            <AutoSuggestBox
                                x:Name="SearchBox"
                                PlaceholderText="Search"
                                QueryIcon="Find"
                                QuerySubmitted="Search_QuerySubmitted"
                                TextChanged="Search_TextChanged"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="12"
                                Foreground="{ThemeResource ShellButtonForegroundBrush}"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Search files in current folder">
                                <AutoSuggestBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                </AutoSuggestBox.Resources>
                            </AutoSuggestBox>
                        </Border>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Border Width="1" Height="18" Margin="2,0,4,0" VerticalAlignment="Center" Background="{ThemeResource ShellGlassEdgeSeparatorBrush}" Opacity="0.5" />
                            <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                                <Button Style="{StaticResource ShellGlassButtonStyle}" Height="28" Padding="8,2,6,2" CornerRadius="4,0,0,4" Click="NewSplitButton_Click" ToolTipService.ToolTip="New folder" AutomationProperties.Name="New folder">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE710;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12" Foreground="{ThemeResource ShellIconForegroundBrush}" />
                                        <TextBlock Text="New" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource ShellButtonForegroundBrush}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ShellGlassButtonStyle}" Width="22" Height="28" Padding="0" CornerRadius="0,4,4,0" ToolTipService.ToolTip="More new item types" AutomationProperties.Name="New item menu">
                                    <FontIcon Glyph="&#xE70D;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="9" Foreground="{ThemeResource ShellSecondaryForegroundBrush}" />
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                            <MenuFlyoutItem Text="New folder" Click="NewFolderMenuItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8B7;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="New text document" Click="NewTextFileMenuItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8A5;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                            <Button Style="{StaticResource ShellGlassButtonStyle}" Width="28" Height="28" Padding="0" CornerRadius="4" Click="Cut_Click" ToolTipService.ToolTip="Cut (Ctrl+X)" AutomationProperties.Name="Cut">
                                <FontIcon Glyph="&#xE8C6;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="13" Foreground="{ThemeResource ShellIconForegroundBrush}" />
                            </Button>
                            <Button Style="{StaticResource ShellGlassButtonStyle}" Width="28" Height="28" Padding="0" CornerRadius="4" Click="Copy_Click" ToolTipService.ToolTip="Copy (Ctrl+C)" AutomationProperties.Name="Copy">
                                <FontIcon Glyph="&#xE8C8;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="13" Foreground="{ThemeResource ShellIconForegroundBrush}" />
                            </Button>
                            <Button Style="{StaticResource ShellGlassButtonStyle}" Width="28" Height="28" Padding="0" CornerRadius="4" Click="Paste_Click" ToolTipService.ToolTip="Paste (Ctrl+V)" AutomationProperties.Name="Paste">
                                <FontIcon Glyph="&#xE77F;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="13" Foreground="{ThemeResource ShellIconForegroundBrush}" />
                            </Button>
                            <Button Style="{StaticResource ShellGlassButtonStyle}" Width="28" Height="28" Padding="0" CornerRadius="4" Click="RenameSelectedMenuItem_Click" ToolTipService.ToolTip="Rename (F2)" AutomationProperties.Name="Rename">
                                <FontIcon Glyph="&#xE8AC;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="13" Foreground="{ThemeResource ShellIconForegroundBrush}" />
                            </Button>
                            <Button Style="{StaticResource ShellGlassButtonStyle}" Width="28" Height="28" Padding="0" CornerRadius="4" Click="DeleteSelectedMenuItem_Click" ToolTipService.ToolTip="Delete (Del)" AutomationProperties.Name="Delete">
                                <FontIcon Glyph="&#xE74D;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="13" Foreground="{ThemeResource ShellIconForegroundBrush}" />
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Style="{StaticResource ShellGlassButtonStyle}" Height="28" Padding="8,2" CornerRadius="4" ToolTipService.ToolTip="View options" AutomationProperties.Name="View">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE8A9;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="13" Foreground="{ThemeResource ShellIconForegroundBrush}" />
                                    <FontIcon Glyph="&#xE70D;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="9" Foreground="{ThemeResource ShellSecondaryForegroundBrush}" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <RadioMenuFlyoutItem x:Name="ViewDetailsRadio" Text="Details" GroupName="ViewMode" Click="DetailsViewButton_Click">
                                            <RadioMenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE179;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                            </RadioMenuFlyoutItem.Icon>
                                        </RadioMenuFlyoutItem>
                                        <RadioMenuFlyoutItem x:Name="ViewCompactRadio" Text="Compact" GroupName="ViewMode" Click="CompactViewButton_Click">
                                            <RadioMenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE71D;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                            </RadioMenuFlyoutItem.Icon>
                                        </RadioMenuFlyoutItem>
                                        <RadioMenuFlyoutItem x:Name="ViewIconsRadio" Text="Icons" GroupName="ViewMode" Click="IconsViewButton_Click">
                                            <RadioMenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE80A;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                            </RadioMenuFlyoutItem.Icon>
                                        </RadioMenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <ToggleMenuFlyoutItem x:Name="DetailsPaneToggleItem" Text="Details pane" Click="DetailsPaneToggleMenuItem_Click" KeyboardAcceleratorTextOverride="Ctrl+Shift+D">
                                            <ToggleMenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xEA49;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                            </ToggleMenuFlyoutItem.Icon>
                                        </ToggleMenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>

                            <Button Style="{StaticResource ShellGlassButtonStyle}" Height="28" Padding="8,2" CornerRadius="4" ToolTipService.ToolTip="Sort options" AutomationProperties.Name="Sort">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE8CB;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="13" Foreground="{ThemeResource ShellIconForegroundBrush}" />
                                    <FontIcon Glyph="&#xE70D;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="9" Foreground="{ThemeResource ShellSecondaryForegroundBrush}" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="SortFlyout_Opening">
                                        <RadioMenuFlyoutItem x:Name="SortNameRadio" Text="Name" GroupName="SortColumn" Click="SortColumnRadio_Click" Tag="Name">
                                            <RadioMenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8CB;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                            </RadioMenuFlyoutItem.Icon>
                                        </RadioMenuFlyoutItem>
                                        <RadioMenuFlyoutItem x:Name="SortTypeRadio" Text="Type" GroupName="SortColumn" Click="SortColumnRadio_Click" Tag="Type">
                                            <RadioMenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8A5;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                            </RadioMenuFlyoutItem.Icon>
                                        </RadioMenuFlyoutItem>
                                        <RadioMenuFlyoutItem x:Name="SortDateRadio" Text="Date modified" GroupName="SortColumn" Click="SortColumnRadio_Click" Tag="DateModified">
                                            <RadioMenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE787;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                            </RadioMenuFlyoutItem.Icon>
                                        </RadioMenuFlyoutItem>
                                        <RadioMenuFlyoutItem x:Name="SortSizeRadio" Text="Size" GroupName="SortColumn" Click="SortColumnRadio_Click" Tag="Size">
                                            <RadioMenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE9F9;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                            </RadioMenuFlyoutItem.Icon>
                                        </RadioMenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <RadioMenuFlyoutItem x:Name="SortAscRadio" Text="Ascending" GroupName="SortDirection" Click="SortDirectionRadio_Click" Tag="Ascending">
                                            <RadioMenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74A;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                            </RadioMenuFlyoutItem.Icon>
                                        </RadioMenuFlyoutItem>
                                        <RadioMenuFlyoutItem x:Name="SortDescRadio" Text="Descending" GroupName="SortDirection" Click="SortDirectionRadio_Click" Tag="Descending">
                                            <RadioMenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74B;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                            </RadioMenuFlyoutItem.Icon>
                                        </RadioMenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <ToggleMenuFlyoutItem x:Name="GroupFoldersToggle" Text="Folders first" Click="GroupFoldersToggle_Click">
                                            <ToggleMenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8B7;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                            </ToggleMenuFlyoutItem.Icon>
                                        </ToggleMenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>

                            <Button Style="{StaticResource ShellGlassButtonStyle}" Width="28" Height="28" Padding="0" CornerRadius="4" ToolTipService.ToolTip="More" AutomationProperties.Name="More commands">
                                <FontIcon Glyph="&#xE712;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="13" Foreground="{ThemeResource ShellIconForegroundBrush}" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem Text="Sync pane layout to all tabs" Click="SyncPaneLayout_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE895;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Keyboard shortcuts" Click="ShortcutsHelp_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE765;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Settings" Click="OpenSettings_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE713;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        
        <!-- Section: Main workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" MinWidth="168" MaxWidth="360" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="DetailsPaneSplitterColumn" Width="6" />
                <ColumnDefinition x:Name="DetailsPaneColumn" Width="340" MinWidth="250" MaxWidth="580" />
            </Grid.ColumnDefinitions>

            
            <!-- Section: Sidebar -->
            <Border Grid.Column="0" Margin="8,0,0,6" Background="{ThemeResource ShellSurfaceBackgroundBrush}" BorderBrush="{ThemeResource ShellSurfaceBorderBrush}" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="2" VerticalAlignment="Top" Height="16" Margin="1,1,1,0" CornerRadius="4,4,0,0" Background="{ThemeResource ShellPanelTopSheenBrush}" IsHitTestVisible="False" />

                    <TextBlock Grid.Row="0" Margin="12,10,12,4" Text="Navigation" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource ShellButtonForegroundBrush}" />

                    <TreeView Grid.Row="1" x:Name="NavigationTreeView" ItemsSource="{Binding NavigationTree}" SelectionMode="Single" Expanding="NavigationTree_Expanding" ItemInvoked="NavigationTree_ItemInvoked" Padding="2,0,2,6" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Navigation tree">
                        <TreeView.Resources>
                            <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#5834C9E6" />
                            <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#7034C9E6" />
                            <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="#8034C9E6" />
                            <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#3434C9E6" />
                            <SolidColorBrush x:Key="TreeViewItemBackgroundPressed" Color="#4834C9E6" />
                        </TreeView.Resources>
                        <TreeView.ItemTemplate>
                            <DataTemplate>
                                <TreeViewItem ItemsSource="{Binding Children}" HasUnrealizedChildren="{Binding HasUnrealizedChildren, Mode=OneWay}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" GlyphBrush="{ThemeResource ShellSecondaryForegroundBrush}" CollapsedGlyph="&#xE76C;" ExpandedGlyph="&#xE70D;">
                                    <Grid ColumnSpacing="8" Height="28">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
                                            <FontIcon FontSize="13" Glyph="{Binding Glyph}" Foreground="{ThemeResource ShellSecondaryForegroundBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsSection, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <controls:FileThumbnail DisplaySize="16" FilePath="{Binding FullPath}" IsDirectory="True" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsNavigable, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" FontWeight="{Binding IsSection, Converter={StaticResource SectionToFontWeightConverter}}" Foreground="{ThemeResource ShellButtonForegroundBrush}" />
                                    </Grid>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="0,6,0,6" Width="1" HorizontalAlignment="Center" Background="{ThemeResource ShellGlassEdgeSeparatorBrush}" Opacity="0.45" />

            
            <!-- Section: File list -->
            <Border Grid.Column="2" Margin="0,0,0,6" Background="{ThemeResource ShellSurfaceBackgroundBrush}" BorderBrush="{ThemeResource ShellSurfaceBorderBrush}" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Border VerticalAlignment="Top" Height="14" Margin="1,1,1,0" CornerRadius="4,4,0,0" Background="{ThemeResource ShellPanelTopSheenBrush}" IsHitTestVisible="False" />

                    <Grid>
                        <ListView x:Name="FileList" ItemContainerStyle="{StaticResource ShellListViewItemStyle}" ItemsSource="{Binding SelectedTab.Items}" SelectionMode="Extended" SelectionChanged="FileList_SelectionChanged" Tapped="FileList_Tapped" DoubleTapped="FileList_DoubleTapped" RightTapped="FileList_RightTapped" CanDragItems="True" AllowDrop="True" DragItemsStarting="FileList_DragItemsStarting" DragOver="FileList_DragOver" Drop="FileList_Drop" Visibility="{Binding SelectedTab.ViewState.ViewMode, Converter={StaticResource ViewModeToVisibilityConverter}, ConverterParameter=Details}" Padding="0" AutomationProperties.Name="Files and folders list">
                            <ListView.Header>
                                <Grid Padding="36,8,10,8" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource ShellSubtleBorderBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Click="SortName_Click" Content="NAME" FontWeight="SemiBold" FontSize="10" CharacterSpacing="80" Foreground="{ThemeResource ShellButtonForegroundBrush}" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Opacity="0.85" UseSystemFocusVisuals="True" />
                                    <Button Grid.Column="1" Click="SortType_Click" Content="TYPE" FontWeight="SemiBold" FontSize="10" CharacterSpacing="80" Foreground="{ThemeResource ShellButtonForegroundBrush}" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Opacity="0.85" UseSystemFocusVisuals="True" />
                                    <Button Grid.Column="2" Click="SortDate_Click" Content="DATE MODIFIED" FontWeight="SemiBold" FontSize="10" CharacterSpacing="80" Foreground="{ThemeResource ShellButtonForegroundBrush}" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Opacity="0.85" UseSystemFocusVisuals="True" />
                                    <Button Grid.Column="3" Click="SortSize_Click" Content="SIZE" FontWeight="SemiBold" FontSize="10" CharacterSpacing="80" Foreground="{ThemeResource ShellButtonForegroundBrush}" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Opacity="0.85" UseSystemFocusVisuals="True" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="{Binding DataContext.RowPadding, ElementName=RootGrid}" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <controls:FileThumbnail Grid.Column="0" DisplaySize="20" FilePath="{Binding FullPath}" IsDirectory="{Binding IsDirectory}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource ShellButtonForegroundBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding TypeDisplay}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource ShellSecondaryForegroundBrush}" VerticalAlignment="Center" FontSize="12" />
                                        <TextBlock Grid.Column="3" Text="{Binding ModifiedDisplay}" Foreground="{ThemeResource ShellSecondaryForegroundBrush}" VerticalAlignment="Center" FontSize="12" />
                                        <TextBlock Grid.Column="4" Text="{Binding SizeDisplay}" Foreground="{ThemeResource ShellSecondaryForegroundBrush}" VerticalAlignment="Center" FontSize="12" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ContextFlyout>
                                <MenuFlyout Opening="FileListContextFlyout_Opening">
                                    <MenuFlyoutItem x:Name="OpenMenuItem" Text="Open" Click="OpenSelectedMenuItem_Click" KeyboardAcceleratorTextOverride="Enter">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8A7;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyMenuItem" Text="Copy" Click="CopySelectedMenuItem_Click" KeyboardAcceleratorTextOverride="Ctrl+C">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8C8;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CutMenuItem" Text="Cut" Click="CutSelectedMenuItem_Click" KeyboardAcceleratorTextOverride="Ctrl+X">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8C6;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="PasteMenuItem" Text="Paste" Click="PasteMenuItem_Click" KeyboardAcceleratorTextOverride="Ctrl+V">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE77F;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="RenameMenuItem" Text="Rename" Click="RenameSelectedMenuItem_Click" KeyboardAcceleratorTextOverride="F2">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8AC;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="DeleteMenuItem" Text="Delete" Click="DeleteSelectedMenuItem_Click" KeyboardAcceleratorTextOverride="Del">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="PropertiesMenuItem" Text="Properties" Click="PropertiesMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE946;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="New Folder" Click="NewFolderMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8B7;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                        </ListView>

                        <ListView x:Name="CompactFileList" ItemContainerStyle="{StaticResource ShellListViewItemStyle}" ItemsSource="{Binding SelectedTab.Items}" SelectionMode="Extended" SelectionChanged="FileList_SelectionChanged" Tapped="FileList_Tapped" DoubleTapped="FileList_DoubleTapped" RightTapped="FileList_RightTapped" CanDragItems="True" AllowDrop="True" DragItemsStarting="FileList_DragItemsStarting" DragOver="FileList_DragOver" Drop="FileList_Drop" Visibility="{Binding SelectedTab.ViewState.ViewMode, Converter={StaticResource ViewModeToVisibilityConverter}, ConverterParameter=Compact}" Padding="0" AutomationProperties.Name="Compact files and folders list">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,3" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <controls:FileThumbnail Grid.Column="0" DisplaySize="16" FilePath="{Binding FullPath}" IsDirectory="{Binding IsDirectory}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource ShellButtonForegroundBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding ModifiedDisplay}" Foreground="{ThemeResource ShellSecondaryForegroundBrush}" VerticalAlignment="Center" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <GridView x:Name="IconFileGrid" ItemContainerStyle="{StaticResource ShellGridViewItemStyle}" ItemsSource="{Binding SelectedTab.Items}" SelectionMode="Extended" SelectionChanged="FileList_SelectionChanged" Tapped="FileList_Tapped" DoubleTapped="FileList_DoubleTapped" RightTapped="FileList_RightTapped" CanDragItems="True" AllowDrop="True" DragItemsStarting="FileList_DragItemsStarting" DragOver="FileList_DragOver" Drop="FileList_Drop" Visibility="{Binding SelectedTab.ViewState.ViewMode, Converter={StaticResource ViewModeToVisibilityConverter}, ConverterParameter=Icons}" Padding="8" AutomationProperties.Name="Icon files and folders grid">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="110" Height="92" Padding="10" Spacing="6" HorizontalAlignment="Center">
                                        <controls:FileThumbnail DisplaySize="44" FilePath="{Binding FullPath}" IsDirectory="{Binding IsDirectory}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="2" FontSize="12" Foreground="{ThemeResource ShellButtonForegroundBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <Border
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="28,22"
                            CornerRadius="5"
                            Background="{ThemeResource ShellCommandStripBackgroundBrush}"
                            BorderBrush="{ThemeResource ShellSubtleBorderBrush}"
                            BorderThickness="1"
                            Visibility="{Binding SelectedTab.Items.Count, Converter={StaticResource ZeroCountToVisibilityConverter}}">
                            <StackPanel Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="28" Foreground="{ThemeResource ShellSecondaryForegroundBrush}" HorizontalAlignment="Center" Opacity="0.7" />
                                <TextBlock Text="This folder is empty" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ShellButtonForegroundBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Drop files here or use New to create an item." FontSize="11" Foreground="{ThemeResource ShellSecondaryForegroundBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="18"
                            CornerRadius="5"
                            Background="{ThemeResource ShellCommandStripBackgroundBrush}"
                            BorderBrush="{ThemeResource ShellSubtleBorderBrush}"
                            BorderThickness="1"
                            Visibility="{Binding SelectedTab.IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ProgressRing IsActive="{Binding SelectedTab.IsBusy}" Width="32" Height="32" Foreground="{ThemeResource ShellAccentBrush}" />
                        </Border>

                        <Border
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="420"
                            Padding="16,12"
                            CornerRadius="5"
                            Background="{ThemeResource ShellCommandStripBackgroundBrush}"
                            BorderBrush="{ThemeResource ShellCriticalForegroundBrush}"
                            BorderThickness="1"
                            Visibility="{Binding SelectedTab.ErrorMessage, Converter={StaticResource NullToCollapsedConverter}}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE783;" FontFamily="{ThemeResource SymbolThemeFontFamily}" Foreground="{ThemeResource ShellCriticalForegroundBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedTab.ErrorMessage}" Foreground="{ThemeResource ShellCriticalForegroundBrush}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Button
                x:Name="DetailsPaneSplitter"
                Grid.Column="3"
                Margin="0,6"
                Padding="0"
                MinWidth="6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                UseSystemFocusVisuals="True"
                ToolTipService.ToolTip="Drag or use Left and Right arrow keys to resize details pane. Press Ctrl+Shift+D to focus splitter."
                AutomationProperties.Name="Details pane splitter"
                AutomationProperties.HelpText="Use left and right arrow keys to resize details pane. Use Home and End for minimum and maximum width."
                AutomationProperties.AcceleratorKey="Ctrl+Shift+D"
                PointerPressed="DetailsSplitter_PointerPressed"
                PointerMoved="DetailsSplitter_PointerMoved"
                PointerReleased="DetailsSplitter_PointerReleased"
                PointerCanceled="DetailsSplitter_PointerCanceled"
                KeyDown="DetailsSplitter_KeyDown">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent">
                            <Border
                                x:Name="Track"
                                Width="2"
                                HorizontalAlignment="Center"
                                CornerRadius="1"
                                Background="{ThemeResource ShellSplitterBrush}"
                                Opacity="0.75" />
                            <Border
                                x:Name="HoverGlow"
                                Width="4"
                                HorizontalAlignment="Center"
                                CornerRadius="2"
                                Background="{ThemeResource ShellSplitterHoverBrush}"
                                Opacity="0" />
                            <StackPanel Orientation="Vertical" Spacing="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Ellipse Width="2.5" Height="2.5" Fill="{ThemeResource ShellSecondaryForegroundBrush}" Opacity="0.5" />
                                <Ellipse Width="2.5" Height="2.5" Fill="{ThemeResource ShellSecondaryForegroundBrush}" Opacity="0.5" />
                                <Ellipse Width="2.5" Height="2.5" Fill="{ThemeResource ShellSecondaryForegroundBrush}" Opacity="0.5" />
                                <Ellipse Width="2.5" Height="2.5" Fill="{ThemeResource ShellSecondaryForegroundBrush}" Opacity="0.5" />
                            </StackPanel>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Track.Opacity" Value="1" />
                                            <Setter Target="HoverGlow.Opacity" Value="0.85" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Track.Opacity" Value="1" />
                                            <Setter Target="HoverGlow.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            
            <!-- Section: Details and preview pane -->
            <Border x:Name="DetailsPaneHost" Grid.Column="4" Margin="0,0,8,6" Background="{ThemeResource ShellSurfaceBackgroundBrush}" BorderBrush="{ThemeResource ShellSurfaceBorderBrush}" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="2" VerticalAlignment="Top" Height="16" Margin="1,1,1,0" CornerRadius="4,4,0,0" Background="{ThemeResource ShellPanelTopSheenBrush}" IsHitTestVisible="False" />

                    <TextBlock Grid.Row="0" Margin="12,10,12,6" Text="Details" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource ShellButtonForegroundBrush}" />

                    <Grid Grid.Row="1">
                        <StackPanel
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Margin="16"
                            Visibility="{Binding SelectedTab.PrimarySelection, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter=Invert}">
                            <FontIcon Glyph="&#xE8A5;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="24" Foreground="{ThemeResource ShellSecondaryForegroundBrush}" HorizontalAlignment="Center" Opacity="0.5" />
                            <TextBlock Text="Select a file to see details" FontSize="12" Foreground="{ThemeResource ShellSecondaryForegroundBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>

                        <ScrollViewer x:Name="DetailsPaneScrollViewer" Margin="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsTabStop="True" UseSystemFocusVisuals="True" AutomationProperties.Name="Details and preview pane" Visibility="{Binding SelectedTab.PrimarySelection, Converter={StaticResource NullToCollapsedConverter}}">
                            <StackPanel Spacing="10" Padding="12,0,12,12">
                                <TextBlock Text="{Binding SelectedTab.SelectionSummary}" FontSize="12" Foreground="{ThemeResource ShellSecondaryForegroundBrush}" TextWrapping="Wrap" />

                                <StackPanel Spacing="2">
                                    <TextBlock Text="Name" FontSize="11" Foreground="{ThemeResource ShellSecondaryForegroundBrush}" />
                                    <TextBlock Text="{Binding SelectedTab.PrimarySelection.Name}" TextWrapping="Wrap" FontSize="13" />

                                    <TextBlock Text="Type" FontSize="11" Foreground="{ThemeResource ShellSecondaryForegroundBrush}" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding SelectedTab.PrimarySelection.TypeDisplay}" TextWrapping="Wrap" FontSize="13" />

                                    <TextBlock Text="Path" FontSize="11" Foreground="{ThemeResource ShellSecondaryForegroundBrush}" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding SelectedTab.PrimarySelection.FullPath}" TextWrapping="Wrap" FontSize="12" />

                                    <TextBlock Text="Modified" FontSize="11" Foreground="{ThemeResource ShellSecondaryForegroundBrush}" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding SelectedTab.PrimarySelection.ModifiedDisplay}" TextWrapping="Wrap" FontSize="13" />

                                    <TextBlock Text="Size" FontSize="11" Foreground="{ThemeResource ShellSecondaryForegroundBrush}" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding SelectedTab.PrimarySelection.SizeDisplay}" TextWrapping="Wrap" FontSize="13" />
                                </StackPanel>

                                <Border Height="1" Background="{ThemeResource ShellSubtleBorderBrush}" Margin="0,4,0,0" />

                                <TextBlock Text="Preview" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="{Binding SelectedTab.PreviewMessage}" FontSize="12" Foreground="{ThemeResource ShellSecondaryForegroundBrush}" TextWrapping="Wrap" />

                                <ProgressRing IsActive="{Binding SelectedTab.IsPreviewLoading}" Width="24" Height="24" HorizontalAlignment="Left" Foreground="{ThemeResource ShellAccentBrush}" />

                                <Border CornerRadius="4" Padding="4" Background="{ThemeResource ShellInputBackgroundBrush}" Visibility="{Binding SelectedTab.PreviewImagePath, Converter={StaticResource NullToCollapsedConverter}}">
                                    <Image
                                        Source="{Binding SelectedTab.PreviewImagePath, Converter={StaticResource FilePathToImageSourceConverter}}"
                                        Stretch="Uniform"
                                        MaxHeight="320"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>

                                <Border CornerRadius="4" Padding="2" Background="{ThemeResource ShellCommandStripBackgroundBrush}" BorderBrush="{ThemeResource ShellSubtleBorderBrush}" BorderThickness="1" Visibility="{Binding SelectedTab.PreviewMediaPath, Converter={StaticResource NullToCollapsedConverter}}">
                                    <MediaPlayerElement
                                        x:Name="PreviewMediaPlayer"
                                        Source="{Binding SelectedTab.PreviewMediaPath, Converter={StaticResource FilePathToMediaSourceConverter}}"
                                        AreTransportControlsEnabled="True"
                                        AutoPlay="False"
                                        Stretch="Uniform"
                                        MinHeight="120"
                                        MaxHeight="320"
                                        HorizontalAlignment="Stretch" />
                                </Border>

                                <Border CornerRadius="4" Padding="8" Background="{ThemeResource ShellInputBackgroundBrush}" Visibility="{Binding SelectedTab.PreviewText, Converter={StaticResource NullToCollapsedConverter}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxHeight="260">
                                        <TextBlock
                                            Text="{Binding SelectedTab.PreviewText}"
                                            TextWrapping="Wrap"
                                            FontFamily="Cascadia Mono"
                                            FontSize="12" />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border
            x:Name="SyncToastHost"
            Grid.Row="1"
            Margin="0,10,14,0"
            Padding="12,8"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            MaxWidth="460"
            CornerRadius="5"
            Background="{ThemeResource ShellToastBackgroundBrush}"
            BorderBrush="{ThemeResource ShellToastBorderBrush}"
            BorderThickness="1"
            Visibility="Collapsed">
            <Grid>
                <Border VerticalAlignment="Top" Height="10" Margin="1,1,1,0" CornerRadius="4,4,0,0" Background="{ThemeResource ShellPanelTopSheenBrush}" IsHitTestVisible="False" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontFamily="{ThemeResource SymbolThemeFontFamily}" Foreground="{ThemeResource ShellToastIconForegroundBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="SyncToastText" Grid.Column="1" Foreground="{ThemeResource ShellToastForegroundBrush}" FontSize="12" TextWrapping="Wrap" />
                </Grid>
            </Grid>
        </Border>

        
        <!-- Section: Status bar -->
        <Border Grid.Row="2" Margin="8,0,8,6" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource ShellSubtleBorderBrush}" Background="{ThemeResource ShellCommandStripBackgroundBrush}">
            <Grid Padding="10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusLine}" FontSize="11" Foreground="{ThemeResource ShellSecondaryForegroundBrush}" AutomationProperties.Name="Status" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource ShellGlassButtonStyle}" Padding="8,2" MinHeight="0" Height="22" CornerRadius="3" Click="OpenOperationsQueue_Click" ToolTipService.ToolTip="Open operation queue inspector">
                    <TextBlock Text="{Binding OperationsSummary}" FontSize="10" />
                </Button>
            </Grid>
        </Border>

    </Grid>
</Window>

